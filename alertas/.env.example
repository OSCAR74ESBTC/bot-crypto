# Copia este archivo como .env y rellénalo. NUNCA subas .env a git.
TELEGRAM_TOKEN=pon_aqui_el_token_de_BotFather
TELEGRAM_CHAT_ID=-100xxxxxxxxxx

# Opcionales (valores por defecto entre paréntesis)
# UMBRAL_K=5               # veces lo normal del activo para avisar
# HORIZONTES_MIN=1,5       # ventanas de tiempo en minutos
# ENFRIAMIENTO_MIN=15      # minutos sin repetir aviso del mismo activo y dirección
# MERCADO_PARADO_MIN=5     # minutos sin ticks para dar el mercado por cerrado
# INTERVALO_SEG=15         # cada cuántos segundos se revisa
# LATIDO_HORA=09:00         # hora diaria (hora del VPS) del aviso "sigo vivo"; "no" lo desactiva
